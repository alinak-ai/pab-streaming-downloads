+IN_PROC_BROWSER_TEST_F(StreamingDownloadLifecycleTest, CancelPendingWrite) {
+  DownloadItem* item = StartStream();
+  ASSERT_TRUE(item);
+  ASSERT_NO_FATAL_FAILURE(PauseStream(item));
+  auto write = base::MakeRefCounted<DownloadsStreamDownloadWriteFunction>();
+  api_test_utils::SendResponseHelper response(write.get());
+  StartWrite(item, write.get());
+  EXPECT_FALSE(response.has_response());
+  ASSERT_TRUE(RunFunction(base::MakeRefCounted<DownloadsCancelFunction>(),
+                          DownloadItemIdAsArgList(item)));
+  response.WaitForResponse();
+  EXPECT_FALSE(response.GetResponse());
+  EXPECT_EQ("Unable to write to download stream", write->GetError());
+  ASSERT_TRUE(base::test::RunUntil([&] { return SessionCount() == 0; }));
+  base::RunLoop()
+      .RunUntilIdle();  // Late Mojo completion must not respond twice.
+}
