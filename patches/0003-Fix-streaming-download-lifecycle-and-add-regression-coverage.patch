+  size_t size_for_testing() const { return sessions_.size(); }
+
  private:
+  void ScheduleRemoveSession(int id) {
+    // Do not delete a session while its DownloadItem observer or Mojo callback
+    // is still on the stack. Closed sessions already reject writes and finish.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&StreamingDownloadRegistry::RemoveSession,
+                                  weak_factory_.GetWeakPtr(), id));
+  }
+
+  void RemoveSession(int id) { sessions_.erase(id); }
+
+  void OnExtensionUnloaded(BrowserContext* context,
+                           const Extension* extension,
+                           UnloadedExtensionReason reason) override {
+    // Detach ownership first: cancellation and API responses can notify other
+    // observers, which must not find the sessions being aborted.
+    std::vector<std::unique_ptr<StreamingDownloadSession>> removed;
+    for (auto it = sessions_.begin(); it != sessions_.end();) {
+      if (it->second->BelongsTo(extension->id())) {
+        removed.push_back(std::move(it->second));
+        it = sessions_.erase(it);
+      } else {
+        ++it;
+      }
+    }
+    for (auto& session : removed) {
+      session->Abort();
+    }
+  }
+
+  void OnShutdown(ExtensionRegistry* registry) override { Shutdown(); }
+
+  void Shutdown() {
+    if (shutting_down_) {
+      return;
+    }
+    shutting_down_ = true;
+    extension_observation_.Reset();
+    weak_factory_.InvalidateWeakPtrs();
+    auto sessions = std::move(sessions_);
+    sessions_.clear();
+    for (auto& entry : sessions) {
+      entry.second->Abort();
+    }
+  }
+
+  bool shutting_down_ = false;
   std::map<int, std::unique_ptr<StreamingDownloadSession>> sessions_;
+  base::ScopedObservation<ExtensionRegistry, ExtensionRegistryObserver>
+      extension_observation_{this};
+  base::WeakPtrFactory<StreamingDownloadRegistry> weak_factory_{this};
 };
 
