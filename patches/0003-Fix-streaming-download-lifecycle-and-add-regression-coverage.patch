+IN_PROC_BROWSER_TEST_F(StreamingDownloadLifecycleTest, RejectInvalidFilenames) {
+  constexpr const char* kInvalidOptions[] = {
+      R"([{"filename":""}])",
+      R"([{"filename":"/absolute.bin"}])",
+      R"([{"filename":"C:\\absolute.bin"}])",
+      R"([{"filename":"../escape.bin"}])",
+      R"([{"filename":"folder/../../escape.bin"}])",
+      R"([{"filename":"..\\escape.bin"}])"};
+  DownloadManager::DownloadVector before;
+  GetCurrentManager()->GetAllDownloads(&before);
+  const size_t initial_sessions = SessionCount();
+  for (const char* options : kInvalidOptions) {
+    SCOPED_TRACE(options);
+    EXPECT_EQ(errors::kInvalidFilename,
+              RunFunctionAndReturnError(
+                  base::MakeRefCounted<DownloadsStreamDownloadStartFunction>(),
+                  options));
+    EXPECT_EQ(initial_sessions, SessionCount());
+    DownloadManager::DownloadVector after;
+    GetCurrentManager()->GetAllDownloads(&after);
+    EXPECT_EQ(before.size(), after.size());
+  }
+}
