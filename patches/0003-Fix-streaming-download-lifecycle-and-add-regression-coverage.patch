+// Exercise the actual download item and pipe, and inspect the registry so a
+// stale session cannot be hidden by rejecting calls on a cancelled download.
+class StreamingDownloadLifecycleTest : public DownloadExtensionTest {
+ protected:
+  void SetUpOnMainThread() override {
+    DownloadExtensionTest::SetUpOnMainThread();
+    LoadExtension("downloads_split");
+    dispatcher_ = std::make_unique<ExtensionFunctionDispatcher>(
+        current_browser()->profile());
+  }
+
+  void TearDownOnMainThread() override {
+    dispatcher_.reset();
+    DownloadExtensionTest::TearDownOnMainThread();
+  }
+
+  DownloadItem* StartStream() {
+    auto result = RunFunctionAndReturnResult(
+        base::MakeRefCounted<DownloadsStreamDownloadStartFunction>(),
+        R"([{"filename":"stream-lifecycle.bin"}])");
+    EXPECT_TRUE(result && result->is_int());
+    if (!result || !result->is_int()) {
+      return nullptr;
+    }
+    return GetCurrentManager()->GetDownload(result->GetInt());
+  }
+
+  size_t SessionCount() {
+    return GetStreamingDownloadSessionCountForTesting(
+        current_browser()->profile());
+  }
+
+  void PauseStream(DownloadItem* item) {
+    ASSERT_TRUE(
+        base::test::RunUntil([&] { return !item->GetFullPath().empty(); }));
+    item->Pause();
+    // Pause is posted to the file sequence. Wait for it without a timing sleep.
+    base::RunLoop paused;
+    download::GetDownloadTaskRunner()->PostTaskAndReply(
+        FROM_HERE, base::DoNothing(), paused.QuitClosure());
+    paused.Run();
+  }
+
+  void StartWrite(
+      DownloadItem* item,
+      DownloadsStreamDownloadWriteFunction* function,
+      base::Value::BlobStorage data = base::Value::BlobStorage(1024 * 1024, 42),
+      const Extension* owner = nullptr) {
+    function->set_extension(owner ? owner : extension());
+    function->SetDispatcher(dispatcher_->AsWeakPtr());
+    base::Value::List args;
+    args.Append(static_cast<int>(item->GetId()));
+    args.Append(base::Value(std::move(data)));
+    function->SetArgs(std::move(args));
+    function->RunWithValidation().Execute();
+  }
+
+  void FinishAndRead(DownloadItem* item, std::string* contents) {
+    ASSERT_TRUE(RunFunction(
+        base::MakeRefCounted<DownloadsStreamDownloadFinishFunction>(),
+        DownloadItemIdAsArgList(item)));
+    ASSERT_TRUE(base::test::RunUntil([&] { return item->IsDone(); }));
+    ASSERT_EQ(DownloadItem::COMPLETE, item->GetState());
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(base::ReadFileToString(item->GetTargetFilePath(), contents));
+  }
+
+ private:
+  std::unique_ptr<ExtensionFunctionDispatcher> dispatcher_;
+};
+
+IN_PROC_BROWSER_TEST_F(StreamingDownloadLifecycleTest, SavedFileContentsMatch) {
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  base::ScopedTempDir download_directory;
+  ASSERT_TRUE(download_directory.CreateUniqueTempDir());
+  DownloadPrefs(current_browser()->profile())
+      .SetDownloadPath(download_directory.GetPath());
+
+  DownloadItem* item = StartStream();
+  ASSERT_TRUE(item);
+  ScopedCancellingItem canceller(item);
+  // Uneven boundaries and chunks larger than the pipe exercise partial writes.
+  // Each chunk has a different binary pattern, including NUL and high bytes.
+  constexpr std::array<size_t, 5> kChunkSizes = {1, 4093, 64 * 1024 + 17,
+                                                 1024 * 1024 + 13, 31};
+  std::string expected;
+  for (size_t index = 0; index < kChunkSizes.size(); ++index) {
+    SCOPED_TRACE(index);
+    base::Value::BlobStorage chunk(kChunkSizes[index]);
+    for (size_t offset = 0; offset < chunk.size(); ++offset) {
+      chunk[offset] = static_cast<uint8_t>(
+          (index * 67 + offset * 31 + (offset >> 8)) & 0xff);
+    }
+    expected.append(chunk.begin(), chunk.end());
+    auto write = base::MakeRefCounted<DownloadsStreamDownloadWriteFunction>();
+    api_test_utils::SendResponseHelper response(write.get());
+    StartWrite(item, write.get(), std::move(chunk));
+    response.WaitForResponse();
+    ASSERT_TRUE(response.GetResponse()) << write->GetError();
+  }
+
+  ASSERT_TRUE(
+      RunFunction(base::MakeRefCounted<DownloadsStreamDownloadFinishFunction>(),
+                  DownloadItemIdAsArgList(item)));
+  ASSERT_TRUE(base::test::RunUntil([&] { return item->IsDone(); }));
+  ASSERT_EQ(DownloadItem::COMPLETE, item->GetState());
+  ASSERT_EQ(download_directory.GetPath(), item->GetTargetFilePath().DirName());
+  EXPECT_EQ(static_cast<int64_t>(expected.size()), item->GetReceivedBytes());
+  EXPECT_EQ(static_cast<int64_t>(expected.size()), item->GetTotalBytes());
+
+  std::string actual;
+  ASSERT_TRUE(base::ReadFileToString(item->GetTargetFilePath(), &actual));
+  ASSERT_EQ(expected.size(), actual.size());
+  const auto mismatch =
+      std::mismatch(expected.begin(), expected.end(), actual.begin());
+  // Report the first bad offset without dumping a megabyte of binary output.
+  EXPECT_EQ(expected.size(),
+            static_cast<size_t>(mismatch.first - expected.begin()))
+      << "Saved file differs at this byte offset";
+}
+
+IN_PROC_BROWSER_TEST_F(StreamingDownloadLifecycleTest, ExtensionOwnership) {
+  LoadSecondExtension("downloads_spanning");
+  const Extension* other = ExtensionRegistry::Get(current_browser()->profile())
+                               ->enabled_extensions()
+                               .GetByID(GetSecondExtensionId());
+  ASSERT_TRUE(other);
+  DownloadItem* item = StartStream();
+  ASSERT_TRUE(item);
+  ScopedCancellingItem canceller(item);
+
+  auto unauthorized =
+      base::MakeRefCounted<DownloadsStreamDownloadWriteFunction>();
+  api_test_utils::SendResponseHelper rejected(unauthorized.get());
+  StartWrite(item, unauthorized.get(), base::Value::BlobStorage{99}, other);
+  rejected.WaitForResponse();
+  EXPECT_FALSE(rejected.GetResponse());
+  EXPECT_EQ(errors::kInvalidId, unauthorized->GetError());
+  EXPECT_EQ(errors::kInvalidId,
+            RunFunctionAndReturnErrorInSecondExtension(
+                base::MakeRefCounted<DownloadsStreamDownloadFinishFunction>(),
+                DownloadItemIdAsArgList(item)));
+  EXPECT_EQ(1u, SessionCount());
+  EXPECT_EQ(DownloadItem::IN_PROGRESS, item->GetState());
+
+  // Rejected calls must not close or append bytes to the owner's stream.
+  auto authorized =
+      base::MakeRefCounted<DownloadsStreamDownloadWriteFunction>();
+  api_test_utils::SendResponseHelper accepted(authorized.get());
+  StartWrite(item, authorized.get(), base::Value::BlobStorage{0, 42, 255});
+  accepted.WaitForResponse();
+  ASSERT_TRUE(accepted.GetResponse()) << authorized->GetError();
+  std::string contents;
+  ASSERT_NO_FATAL_FAILURE(FinishAndRead(item, &contents));
+  EXPECT_EQ(std::string("\0\x2a\xff", 3), contents);
+  EXPECT_EQ(0u, SessionCount());
+}
+
+IN_PROC_BROWSER_TEST_F(StreamingDownloadLifecycleTest,
+                       RejectOverlappingWrites) {
+  DownloadItem* item = StartStream();
+  ASSERT_TRUE(item);
+  ScopedCancellingItem canceller(item);
+  ASSERT_NO_FATAL_FAILURE(PauseStream(item));
+  auto first = base::MakeRefCounted<DownloadsStreamDownloadWriteFunction>();
+  api_test_utils::SendResponseHelper pending(first.get());
+  StartWrite(item, first.get());
+  ASSERT_FALSE(pending.has_response());
+
+  auto second = base::MakeRefCounted<DownloadsStreamDownloadWriteFunction>();
+  api_test_utils::SendResponseHelper rejected(second.get());
+  StartWrite(item, second.get(), base::Value::BlobStorage{99});
+  rejected.WaitForResponse();
+  EXPECT_FALSE(rejected.GetResponse());
+  EXPECT_EQ("Download stream is busy or already finished", second->GetError());
+  EXPECT_FALSE(pending.has_response());
+  EXPECT_EQ(1u, SessionCount());
+
+  item->Resume(true);
+  pending.WaitForResponse();
+  ASSERT_TRUE(pending.GetResponse()) << first->GetError();
+  std::string contents;
+  ASSERT_NO_FATAL_FAILURE(FinishAndRead(item, &contents));
+  ASSERT_EQ(1024u * 1024u, contents.size());
+  EXPECT_TRUE(std::all_of(contents.begin(), contents.end(),
+                          [](char byte) { return byte == 42; }));
+}
+
+IN_PROC_BROWSER_TEST_F(StreamingDownloadLifecycleTest,
+                       RejectFinishWhileWriting) {
+  DownloadItem* item = StartStream();
+  ASSERT_TRUE(item);
+  ScopedCancellingItem canceller(item);
+  ASSERT_NO_FATAL_FAILURE(PauseStream(item));
+  auto write = base::MakeRefCounted<DownloadsStreamDownloadWriteFunction>();
+  api_test_utils::SendResponseHelper pending(write.get());
+  StartWrite(item, write.get());
+  ASSERT_FALSE(pending.has_response());
+
+  EXPECT_FALSE(
+      RunFunctionAndReturnError(
+          base::MakeRefCounted<DownloadsStreamDownloadFinishFunction>(),
+          DownloadItemIdAsArgList(item))
+          .empty());
+  EXPECT_FALSE(pending.has_response());
+  EXPECT_EQ(1u, SessionCount());
+  EXPECT_EQ(DownloadItem::IN_PROGRESS, item->GetState());
+
+  item->Resume(true);
+  pending.WaitForResponse();
+  ASSERT_TRUE(pending.GetResponse()) << write->GetError();
+  std::string contents;
+  ASSERT_NO_FATAL_FAILURE(FinishAndRead(item, &contents));
+  ASSERT_EQ(1024u * 1024u, contents.size());
+  EXPECT_TRUE(std::all_of(contents.begin(), contents.end(),
+                          [](char byte) { return byte == 42; }));
+  EXPECT_EQ(0u, SessionCount());
+}
