+  bool Add(DownloadItem* item,
+           const std::string& extension_id,
+           mojo::ScopedDataPipeProducerHandle producer,
+           mojo::Remote<download::mojom::DownloadStreamClient> client) {
+    // The owner may have unloaded while StartDownloadFromStream was pending.
+    if (shutting_down_ || item->GetState() != DownloadItem::IN_PROGRESS ||
+        !extension_observation_.GetSource()->enabled_extensions().Contains(
+            extension_id)) {
+      return false;
+    }
+    const int id = item->GetId();
+    sessions_[id] = std::make_unique<StreamingDownloadSession>(
+        item, extension_id, std::move(producer), std::move(client),
+        base::BindOnce(&StreamingDownloadRegistry::ScheduleRemoveSession,
+                       weak_factory_.GetWeakPtr(), id));
+    return true;
   }
 
   StreamingDownloadSession* Find(int id, const std::string& extension_id) {
     auto it = sessions_.find(id);
-    return it != sessions_.end() && it->second->BelongsTo(extension_id)
+    return it != sessions_.end() && it->second->BelongsTo(extension_id) &&
+                   it->second->IsActive()
                ? it->second.get()
                : nullptr;
   }
 
   bool Finish(int id, const std::string& extension_id) {
-    auto it = sessions_.find(id);
-    if (it == sessions_.end() || !it->second->BelongsTo(extension_id) ||
-        !it->second->Finish()) {
+    auto* session = Find(id, extension_id);
+    if (!session || !session->Finish()) {
       return false;
     }
-    sessions_.erase(it);
+    sessions_.erase(id);
