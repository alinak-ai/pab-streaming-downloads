 namespace {
 
+class BlobDataSource : public mojo::DataPipeProducer::DataSource {
+ public:
+  explicit BlobDataSource(base::Value::BlobStorage data)
+      : data_(std::move(data)) {}
+
+  uint64_t GetLength() const override { return data_.size(); }
+
+  ReadResult Read(uint64_t offset, base::span<char> buffer) override {
+    if (offset >= data_.size())
+      return {0, MOJO_RESULT_OK};
+    const size_t start_offset = static_cast<size_t>(offset);
+    const size_t count = std::min(buffer.size(), data_.size() - start_offset);
+    std::memcpy(buffer.data(), data_.data() + start_offset, count);
+    return {count, MOJO_RESULT_OK};
+  }
+
+ private:
+  base::Value::BlobStorage data_;
+};
+
+class StreamingDownloadSession {
+ public:
+  StreamingDownloadSession(
+      const std::string& extension_id,
+      mojo::ScopedDataPipeProducerHandle producer,
+      mojo::Remote<download::mojom::DownloadStreamClient> completion_client)
+      : extension_id_(extension_id),
+        producer_(std::make_unique<mojo::DataPipeProducer>(
+            std::move(producer))),
+        completion_client_(std::move(completion_client)) {}
+
+  bool BelongsTo(const std::string& extension_id) const {
+    return extension_id_ == extension_id;
+  }
+
+  bool Write(base::Value::BlobStorage data,
+             base::OnceCallback<void(bool)> callback) {
+    if (write_in_progress_ || finished_)
+      return false;
+    write_in_progress_ = true;
+    producer_->Write(
+        std::make_unique<BlobDataSource>(std::move(data)),
+        base::BindOnce(
+            [](StreamingDownloadSession* session,
+               base::OnceCallback<void(bool)> callback, MojoResult result) {
+              session->write_in_progress_ = false;
+              std::move(callback).Run(result == MOJO_RESULT_OK);
+            },
+            base::Unretained(this), std::move(callback)));
+    return true;
+  }
+
+  bool Finish() {
+    if (finished_ || write_in_progress_)
+      return false;
+    finished_ = true;
+    completion_client_->OnStreamCompleted(
+        download::mojom::NetworkRequestStatus::OK);
+    producer_.reset();
+    completion_client_.reset();
+    return true;
+  }
+
+ private:
+  std::string extension_id_;
+  std::unique_ptr<mojo::DataPipeProducer> producer_;
+  mojo::Remote<download::mojom::DownloadStreamClient> completion_client_;
+  bool write_in_progress_ = false;
+  bool finished_ = false;
+};
+
+class StreamingDownloadRegistry : public base::SupportsUserData::Data {
+ public:
+  static StreamingDownloadRegistry* Get(BrowserContext* context) {
+    static int key = 0;
+    auto* registry = static_cast<StreamingDownloadRegistry*>(
+        context->GetUserData(&key));
+    if (!registry) {
+      auto new_registry = std::make_unique<StreamingDownloadRegistry>();
+      registry = new_registry.get();
+      context->SetUserData(&key, std::move(new_registry));
+    }
+    return registry;
+  }
+
+  void Add(int id, std::unique_ptr<StreamingDownloadSession> session) {
+    sessions_[id] = std::move(session);
+  }
+
+  StreamingDownloadSession* Find(int id, const std::string& extension_id) {
+    auto it = sessions_.find(id);
+    return it != sessions_.end() && it->second->BelongsTo(extension_id)
+               ? it->second.get()
+               : nullptr;
+  }
+
+  bool Finish(int id, const std::string& extension_id) {
+    auto it = sessions_.find(id);
+    if (it == sessions_.end() || !it->second->BelongsTo(extension_id) ||
+        !it->second->Finish()) {
+      return false;
+    }
+    sessions_.erase(it);
+    return true;
+  }
+
+ private:
+  std::map<int, std::unique_ptr<StreamingDownloadSession>> sessions_;
+};
