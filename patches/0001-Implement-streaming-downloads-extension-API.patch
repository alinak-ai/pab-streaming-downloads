@@ -12,6 +12,7 @@ function contains_all(obj, keys) {
 
 var contents = [
   'download', 'search', 'pause', 'resume', 'cancel', 'getFileIcon', 'open',
+  'streamDownloadStart', 'streamDownloadWrite', 'streamDownloadFinish',
   'show', 'erase', 'acceptDanger', 'onCreated', 'onChanged', 'onErased',
   'onDeterminingFilename'];
 
@@ -19,5 +20,48 @@ if (!chrome.downloads ||
     !contains_all(chrome.downloads, contents)) {
   chrome.test.fail();
 } else {
-  chrome.test.succeed();
+  chrome.test.runTests([
+    function streamDownloadWritesChunksToRegularDownload() {
+      const chunks = [
+        new Uint8Array([0, 1, 2, 255]),
+        new Uint8Array([10, 20, 30]),
+        new Uint8Array([40, 50])
+      ];
+      const expectedSize = chunks.reduce((sum, chunk) => sum + chunk.length, 0);
+      chrome.downloads.streamDownloadStart(
+          {filename: 'stream-api-test.bin'}, downloadId => {
+        chrome.test.assertNoLastError();
+        const onChanged = delta => {
+          if (delta.id !== downloadId || !delta.state ||
+              delta.state.current !== 'complete') {
+            return;
+          }
+          chrome.downloads.onChanged.removeListener(onChanged);
+          chrome.downloads.search({id: downloadId}, items => {
+            chrome.test.assertNoLastError();
+            chrome.test.assertEq(1, items.length);
+            chrome.test.assertEq('complete', items[0].state);
+            chrome.test.assertEq(expectedSize, items[0].totalBytes);
+            chrome.test.succeed();
+          });
+        };
+        chrome.downloads.onChanged.addListener(onChanged);
+
+        const writeNext = index => {
+          if (index === chunks.length) {
+            chrome.downloads.streamDownloadFinish(downloadId, () => {
+              chrome.test.assertNoLastError();
+            });
+            return;
+          }
+          chrome.downloads.streamDownloadWrite(
+              downloadId, chunks[index].buffer, () => {
+            chrome.test.assertNoLastError();
+            writeNext(index + 1);
+          });
+        };
+        writeNext(0);
+      });
+    }
+  ]);
 }
