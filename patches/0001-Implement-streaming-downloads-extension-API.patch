+DownloadsStreamDownloadStartFunction::~DownloadsStreamDownloadStartFunction() =
+    default;
+
+ExtensionFunction::ResponseAction
+DownloadsStreamDownloadStartFunction::Run() {
+  std::optional<downloads::StreamDownloadStart::Params> params =
+      downloads::StreamDownloadStart::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  const std::string& filename = params->options.filename;
+  const base::FilePath suggested_name = base::FilePath::FromUTF8Unsafe(filename);
+  if (filename.empty() || !net::IsSafePortableRelativePath(suggested_name)) {
+    return RespondNow(Error(download_extension_errors::kInvalidFilename));
+  }
+
+  mojo::ScopedDataPipeProducerHandle producer;
+  mojo::ScopedDataPipeConsumerHandle consumer;
+  if (mojo::CreateDataPipe(nullptr, producer, consumer) != MOJO_RESULT_OK) {
+    return RespondNow(Error("Unable to create download stream"));
+  }
+
+  auto handle = download::mojom::DownloadStreamHandle::New();
+  handle->stream = std::move(consumer);
+  mojo::Remote<download::mojom::DownloadStreamClient> completion_client;
+  handle->client_receiver =
+      completion_client.BindNewPipeAndPassReceiver();
+
+  auto info = std::make_unique<download::DownloadCreateInfo>();
+  info->start_time = base::Time::Now();
+  info->url_chain.emplace_back(
+      GURL("chrome-extension://" + extension()->id() + "/stream-download"));
+  info->tab_url = extension()->url();
+  info->request_initiator = url::Origin::Create(extension()->url());
+  info->mime_type = "application/octet-stream";
+  info->original_mime_type = info->mime_type;
+  info->download_source = download::DownloadSource::EXTENSION_API;
+  info->save_info->suggested_name = base::UTF8ToUTF16(filename);
+
+  DownloadManager* manager = browser_context()->GetDownloadManager();
+  manager->StartDownloadFromStream(
+      std::move(info),
+      std::make_unique<download::StreamHandleInputStream>(std::move(handle)),
+      base::BindOnce(&DownloadsStreamDownloadStartFunction::OnStarted, this,
+                     std::move(producer), std::move(completion_client)));
+  RecordApiFunctions(DOWNLOADS_FUNCTION_STREAM_DOWNLOAD_START);
+  return RespondLater();
+}
+
+void DownloadsStreamDownloadStartFunction::OnStarted(
+    mojo::ScopedDataPipeProducerHandle producer,
+    mojo::Remote<download::mojom::DownloadStreamClient> client,
+    DownloadItem* item,
+    download::DownloadInterruptReason interrupt_reason) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!item) {
+    Respond(Error(download::DownloadInterruptReasonToString(interrupt_reason)));
+    return;
+  }
+  auto session = std::make_unique<StreamingDownloadSession>(
+      extension()->id(), std::move(producer), std::move(client));
+  StreamingDownloadRegistry::Get(browser_context())->Add(item->GetId(),
+                                                        std::move(session));
+  new DownloadedByExtension(item, extension()->id(), extension()->name());
+  item->UpdateObservers();
+  Respond(WithArguments(static_cast<int>(item->GetId())));
+}
+
+DownloadsStreamDownloadWriteFunction::~DownloadsStreamDownloadWriteFunction() =
+    default;
+
+ExtensionFunction::ResponseAction DownloadsStreamDownloadWriteFunction::Run() {
+  std::optional<downloads::StreamDownloadWrite::Params> params =
+      downloads::StreamDownloadWrite::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  StreamingDownloadSession* session =
+      StreamingDownloadRegistry::Get(browser_context())
+          ->Find(params->download_id, extension()->id());
+  if (!session)
+    return RespondNow(Error(download_extension_errors::kInvalidId));
+  if (!session->Write(
+          std::move(params->data),
+          base::BindOnce(&DownloadsStreamDownloadWriteFunction::OnWriteComplete,
+                         this))) {
+    return RespondNow(Error("Download stream is busy or already finished"));
+  }
+  RecordApiFunctions(DOWNLOADS_FUNCTION_STREAM_DOWNLOAD_WRITE);
+  return RespondLater();
+}
+
+void DownloadsStreamDownloadWriteFunction::OnWriteComplete(bool success) {
+  if (success)
+    Respond(NoArguments());
+  else
+    Respond(Error("Unable to write to download stream"));
+}
+
+DownloadsStreamDownloadFinishFunction::~DownloadsStreamDownloadFinishFunction() =
+    default;
+
+ExtensionFunction::ResponseAction
+DownloadsStreamDownloadFinishFunction::Run() {
+  std::optional<downloads::StreamDownloadFinish::Params> params =
+      downloads::StreamDownloadFinish::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  if (!StreamingDownloadRegistry::Get(browser_context())
+           ->Finish(params->download_id, extension()->id())) {
+    return RespondNow(Error(download_extension_errors::kInvalidId));
+  }
+  RecordApiFunctions(DOWNLOADS_FUNCTION_STREAM_DOWNLOAD_FINISH);
+  return RespondNow(NoArguments());
+}
